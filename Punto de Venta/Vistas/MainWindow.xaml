<Window x:Class="Punto_de_Venta.MainWindow"
        PreviewKeyDown="Window_PreviewKeyDown"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Imagenes/CHC_icono.ico"
        Width="1280" Height="720"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeWindowBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <StreamGeometry x:Key="IconCobro">M 8,19 A 1,1 0 1 0 8,21 A 1,1 0 1 0 8,19 Z M 19,19 A 1,1 0 1 0 19,21 A 1,1 0 1 0 19,19 Z M 2.05,2.05 L 4.05,2.05 L 6.71,14.47 A 2,2 0 0 0 8.71,16.05 L 18.49,16.05 A 2,2 0 0 0 20.44,14.48 L 22.09,7.05 L 5.12,7.05</StreamGeometry>
        <StreamGeometry x:Key="IconVentas">M 4,2 L 4,22 L 6,21 L 8,22 L 10,21 L 12,22 L 14,21 L 16,22 L 18,21 L 20,22 L 20,2 L 18,3 L 16,2 L 14,3 L 12,2 L 10,3 L 8,2 L 6,3 Z M 16,8 L 10,8 A 2,2 0 1 0 10,12 L 14,12 A 2,2 0 1 1 14,16 L 8,16 M 12,17.5 L 12,6.5</StreamGeometry>
        <StreamGeometry x:Key="IconInventario">M 8,2 L 16,2 L 16,6 L 8,6 Z M 16,4 L 18,4 A 2,2 0 0 1 20,6 L 20,20 A 2,2 0 0 1 18,22 L 6,22 A 2,2 0 0 1 4,20 L 4,6 A 2,2 0 0 1 6,4 L 8,4 M 12,11 L 16,11 M 12,16 L 16,16 M 8,11 L 8.01,11 M 8,16 L 8.01,16</StreamGeometry>
        <StreamGeometry x:Key="IconPromociones">M 12.586,2.586 A 2,2 0 0 0 11.172,2 L 4,2 A 2,2 0 0 0 2,4 L 2,11.172 A 2,2 0 0 0 2.586,12.586 L 11.29,21.29 A 2.426,2.426 0 0 0 14.71,21.29 L 21.29,14.71 A 2.426,2.426 0 0 0 21.29,11.29 Z M 7.5,7.5 L 7.51,7.5</StreamGeometry>
        <StreamGeometry x:Key="IconPrestamos">M 2,6 L 22,6 L 22,18 L 2,18 Z M 12,15 A 3,3 0 1 0 12,9 A 3,3 0 1 0 12,15 Z M 6,12 L 6.01,12 M 18,12 L 18.01,12</StreamGeometry>
        <StreamGeometry x:Key="IconEtiquetas">M 3,5 L 3,19 M 8,5 L 8,19 M 12,5 L 12,19 M 17,5 L 17,19 M 21,5 L 21,19</StreamGeometry>
        <StreamGeometry x:Key="IconGraficas">M 21,12 c 0.552,0 1.005,-0.449 0.95,-0.998 a 10,10 0 0 0 -8.953,-8.951 c -0.55,-0.055 -0.998,0.398 -0.998,0.95 v 8 a 1,1 0 0 0 1,1 z M 21.21,15.89 A 10,10 0 1 1 8,2.83</StreamGeometry>
        <StreamGeometry x:Key="IconExportar">M 21,15 L 21,19 A 2,2 0 0 1 19,21 L 5,21 A 2,2 0 0 1 3,19 L 3,15 M 17,8 L 12,3 L 7,8 M 12,3 L 12,15</StreamGeometry>
        <StreamGeometry x:Key="IconImportar">M 21,15 L 21,19 A 2,2 0 0 1 19,21 L 5,21 A 2,2 0 0 1 3,19 L 3,15 M 7,10 L 12,15 L 17,10 M 12,15 L 12,3</StreamGeometry>
        <StreamGeometry x:Key="IconConfiguracion">M 21,4 L 14,4 M 10,4 L 3,4 M 21,12 L 12,12 M 8,12 L 3,12 M 21,20 L 16,20 M 12,20 L 3,20 M 14,2 L 14,6 M 8,10 L 8,14 M 16,18 L 16,22</StreamGeometry>
        <StreamGeometry x:Key="IconLibreta">M 4,4 L 4,20 C 4,21.1 4.9,22 6,22 L 18,22 C 19.1,22 20,21.1 20,20 L 20,4 C 20,2.9 19.1,2 18,2 L 6,2 C 4.9,2 4,2.9 4,4 Z M 8,2 L 8,22 M 12,7 L 16,7 M 12,11 L 16,11 M 12,15 L 15,15</StreamGeometry>

        <Style x:Key="WinCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderBtn" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderBtn" Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderBtn" Property="Background" Value="{DynamicResource ThemeBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WinCaptionButtonStyle}">
            <Setter Property="Margin" Value="2,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderBtn" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderBtn" Property="Background" Value="#FFE81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderBtn" Property="Background" Value="#FFC50E1A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeroButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="28" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Effect="{StaticResource FluentCardShadow}" IsHitTestVisible="False" />
                            <Border x:Name="HeroBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Ellipse Width="240" Height="240" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-80,-80,0" Fill="#15FFFFFF" IsHitTestVisible="False"/>
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeroBorder" Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeroBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BentoCardStyle" TargetType="Button">
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Effect="{StaticResource FluentCardShadow}" IsHitTestVisible="False" />
                            <Border x:Name="CardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BentoPillStyle" TargetType="Button">
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportModalCardStyle" TargetType="Button" BasedOn="{StaticResource BentoCardStyle}">
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeWindowBackground}"
            BorderBrush="{DynamicResource ThemeBorder}"
            BorderThickness="1">

        <Grid>

            <Grid x:Name="MainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="ModernTitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="40" Height="26" CornerRadius="4" Background="{DynamicResource ThemeInputBackground}" Margin="0,0,10,0" Padding="4,2">
                            <Image Source="{DynamicResource ThemeLogo}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock x:Name="TxtMiniLogo" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" IsHitTestVisible="False" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Style="{StaticResource WinCaptionButtonStyle}" Click="BtnMinimize_Click" ToolTip="{DynamicResource MainMinimize}">
                            <Path Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource WinCaptionButtonStyle}" Click="BtnMaximize_Click" ToolTip="{DynamicResource MainMaximize}">
                            <Border Width="10" Height="10" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1.5" CornerRadius="2" />
                        </Button>
                        <Button Style="{StaticResource WinCaptionCloseButtonStyle}" Click="BtnClose_Click" ToolTip="{DynamicResource MainClose}">
                            <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid x:Name="GridDashboard" Margin="36,12,36,32" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="-10,-10,-10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Style="{StaticResource HeroButtonStyle}" AutomationProperties.Name="Cobro" Click="Cobro_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Width="68" Height="68" CornerRadius="8" Background="#22FFFFFF" HorizontalAlignment="Left">
                                            <Viewbox Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource IconCobro}" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                            <TextBlock Text="{DynamicResource MainNavCharge}" FontSize="48" FontWeight="ExtraBold" Foreground="White" />
                                            <TextBlock Text="{DynamicResource MainNavChargeDesc}" FontSize="16" FontWeight="Medium" Foreground="#E0FFFFFF" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource BentoCardStyle}" AutomationProperties.Name="Ventas" Click="Ventas_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Width="52" Height="52" CornerRadius="4" Background="{DynamicResource ThemeInputBackground}" HorizontalAlignment="Left">
                                            <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource IconVentas}" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                            <TextBlock Text="{DynamicResource MainNavSales}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="{DynamicResource MainNavSalesDesc}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource BentoCardStyle}" AutomationProperties.Name="Lista Prod" Click="Inventario_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Width="52" Height="52" CornerRadius="4" Background="{DynamicResource ThemeInputBackground}" HorizontalAlignment="Left">
                                            <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource IconInventario}" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                            <TextBlock Text="{DynamicResource MainNavInventory}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="{DynamicResource MainNavInventoryDesc}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource BentoCardStyle}" AutomationProperties.Name="Promociones" Click="Promociones_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Width="52" Height="52" CornerRadius="4" Background="{DynamicResource ThemeInputBackground}" HorizontalAlignment="Left">
                                            <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource IconPromociones}" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                            <TextBlock x:Name="TxtTituloPromociones" Text="{DynamicResource MainNavPromos}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="{DynamicResource MainNavPromosDesc}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource BentoCardStyle}" AutomationProperties.Name="Prestamo" Click="Prestamos_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Width="52" Height="52" CornerRadius="4" Background="{DynamicResource ThemeInputBackground}" HorizontalAlignment="Left">
                                            <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource IconPrestamos}" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                            <TextBlock x:Name="TxtTituloPrestamos" Text="{DynamicResource MainNavCredits}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="{DynamicResource MainNavCreditsDesc}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Grid>

                            <UniformGrid Grid.Row="1" Rows="1" Columns="6" Height="86" Margin="-8,14,-8,0">
                                <Button Style="{StaticResource BentoPillStyle}" AutomationProperties.Name="Codigos de Barras" Click="CodigosDeBarras_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconEtiquetas}" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="TxtTituloEtiquetas" Text="{DynamicResource MainNavBarcodes}" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BentoPillStyle}" AutomationProperties.Name="Graficas" Click="Graficas_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconGraficas}" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{DynamicResource MainNavCharts}" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BentoPillStyle}" AutomationProperties.Name="Libreta" Click="Libreta_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconLibreta}" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{DynamicResource MainNavNotebook}" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ExportButton" Style="{StaticResource BentoPillStyle}" AutomationProperties.Name="Exportar" Click="Exportar_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconExportar}" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="TxtTituloExportar" Text="{DynamicResource MainNavExport}" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource BentoPillStyle}" AutomationProperties.Name="Subir List" Click="AbrirModalImportar_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconImportar}" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{DynamicResource MainNavImport}" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource BentoPillStyle}" AutomationProperties.Name="Configuracion" Click="Configuracion_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconConfiguracion}" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{DynamicResource MainNavConfig}" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                    </StackPanel>
                                </Button>
