<Window x:Class="Punto_de_Venta.Vistas.PantallaClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Imagenes/CHC_icono.ico"
        Title="Pantalla del Cliente - Chip&amp;Chapa"
        Width="1024" Height="640"
        MinWidth="760" MinHeight="480"
        Background="{DynamicResource ThemeWindowBackground}"
        TextElement.Foreground="{DynamicResource ThemeTextForeground}"
        FontFamily="Segoe UI Variable, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="20,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Imagenes/CHC_logo.png" Width="46" Height="30" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtNombreNegocio" Text="Chip&amp;Chapa" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" />
                        <TextBlock x:Name="TxtEstadoCliente" Text="Listo para atenderte" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtReloj" Text="12:00 PM" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Tus productos" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" />
                        <TextBlock x:Name="TxtConteoArticulosHeader" DockPanel.Dock="Right" HorizontalAlignment="Right" Text="0 articulos" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedForeground}" VerticalAlignment="Center" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListaProductosCliente">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}" CornerRadius="8" Padding="12,6" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding CantidadTexto}" FontSize="18" FontWeight="Bold" Foreground="White" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nombre}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PrecioUnitarioTexto}" FontSize="14" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding SubtotalTexto}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="PanelBienvenidaCliente" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="🛒" FontSize="54" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="¡Bienvenido!" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" HorizontalAlignment="Center" />
                        <TextBlock Text="Aqui veras cada producto, su precio y el total en tiempo real." FontSize="15" Foreground="{DynamicResource ThemeMutedForeground}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="24">
                <Grid>
                    <StackPanel x:Name="PanelResumenTotal" VerticalAlignment="Center">
                        <TextBlock Text="RESUMEN DE COMPRA" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,0,0,18" />

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Articulos" FontSize="16" Foreground="{DynamicResource ThemeMutedForeground}" />
                            <TextBlock x:Name="TxtCantidadTotal" Text="0" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Subtotal" FontSize="16" Foreground="{DynamicResource ThemeMutedForeground}" />
                            <TextBlock x:Name="TxtSubtotal" Text="$0.00" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid x:Name="FilaDescuento" Visibility="Collapsed" Margin="0,0,0,14">
                            <TextBlock Text="Descuento promociones" FontSize="16" Foreground="#10B981" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtDescuento" Text="-$0.00" FontSize="18" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,18" />

                        <TextBlock Text="TOTAL A PAGAR" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" />
                        <TextBlock x:Name="TxtTotalPagar" Text="$0.00" FontSize="54" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="PanelGraciasCompra" Visibility="Collapsed" VerticalAlignment="Center">
                        <Border Background="#1810B981" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="✓ ¡Gracias por su compra!" FontSize="24" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Total" FontSize="16" Foreground="{DynamicResource ThemeMutedForeground}" />
                                    <TextBlock x:Name="TxtGraciasTotal" Text="$0.00" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Pagó con" FontSize="16" Foreground="{DynamicResource ThemeMutedForeground}" />
                                    <TextBlock x:Name="TxtGraciasPagoCon" Text="$0.00" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" HorizontalAlignment="Right" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,4,0,12" />
                                <TextBlock Text="SU CAMBIO" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TxtGraciasCambio" Text="$0.00" FontSize="42" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

