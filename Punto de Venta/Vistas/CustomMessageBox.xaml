<Window x:Class="Punto_de_Venta.Vistas.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mensaje" 
        UseLayoutRounding="True" 
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" 
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="None" AllowsTransparency="True" Background="#66000000"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False"
        TextElement.Foreground="{DynamicResource ThemeTextForeground}">
    

    <Window.Resources>
        <DropShadowEffect x:Key="AppleModalShadow" BlurRadius="40" ShadowDepth="12" Direction="270" Color="#000000" Opacity="0.2" />

        <Style x:Key="AlertButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, -apple-system" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="12" Margin="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ThemeBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ThemeMutedForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AlertPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AlertButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="12" Margin="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid MouseDown="Fondo_MouseDown" Background="Transparent">
        <Border MinWidth="340" MaxWidth="540" MinHeight="160" MaxHeight="600" 
                Background="{DynamicResource ThemeSurfaceBackground}" 
                BorderBrush="{DynamicResource ThemeBorder}" 
                BorderThickness="1" CornerRadius="24" Padding="24" 
                HorizontalAlignment="Center" VerticalAlignment="Center" 
                Effect="{StaticResource AppleModalShadow}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="TxtTitle" Text="Aviso" FontFamily="Segoe UI Variable, Segoe UI, -apple-system" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" HorizontalAlignment="Center" Margin="0,0,0,12" TextAlignment="Center" TextWrapping="Wrap" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,24">
                    <TextBlock x:Name="TxtMessage" Text="Cuerpo del mensaje" FontFamily="Segoe UI Variable, Segoe UI, -apple-system" FontSize="14" Foreground="{DynamicResource ThemeTextForeground}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </ScrollViewer>
                <UniformGrid Grid.Row="2" x:Name="BotonesGrid" Rows="1" Columns="2">
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Window>