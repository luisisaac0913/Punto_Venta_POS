<UserControl x:Class="Punto_de_Venta.Configuracion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="960" MinHeight="600"
        Background="Transparent"
        Focusable="True"
        IsVisibleChanged="UserControl_IsVisibleChanged"
        PreviewKeyDown="UserControl_PreviewKeyDown"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SystemGreen" Color="#34C759" />

        <Style x:Key="ConfigCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Effect" Value="{StaticResource FluentShadow}" />
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,10,24,18" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configuracion" Visibility="Collapsed" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition x:Name="PreviewColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ConfigCardStyle}" Padding="12,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SettingsSidebarHeader}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" Margin="8,0,0,10" />
                    <Button x:Name="NavImpresionBtn" Content="{DynamicResource SettingsNavPrint}" Style="{StaticResource SidebarButtonStyle}" Click="NavImpresion_Click" />
                    <Button x:Name="NavPersonalizacionBtn" Content="{DynamicResource SettingsNavPersonalization}" Style="{StaticResource SidebarButtonStyle}" Click="NavPersonalizacion_Click" />
                    <Button x:Name="NavBasculaBtn" Content="{DynamicResource SettingsNavScale}" Style="{StaticResource SidebarButtonStyle}" Click="NavBascula_Click" />
                    <Button x:Name="NavServidorLocalBtn" Content="{DynamicResource SettingsNavServer}" Style="{StaticResource SidebarButtonStyle}" Click="NavServidorLocal_Click" />
                    <Button x:Name="NavWhatsAppBtn" Content="{DynamicResource SettingsNavWhatsApp}" Style="{StaticResource SidebarButtonStyle}" Click="NavWhatsApp_Click" />
                    <Button x:Name="NavSeguridadBtn" Content="{DynamicResource SettingsNavSecurity}" Style="{StaticResource SidebarButtonStyle}" Click="NavSeguridad_Click" />
                    <Button x:Name="NavAtajosBtn" Content="{DynamicResource SettingsNavShortcuts}" Style="{StaticResource SidebarButtonStyle}" Click="NavAtajos_Click" />
                    <Button x:Name="NavAyudaBtn" Content="{DynamicResource SettingsNavHelp}" Style="{StaticResource SidebarButtonStyle}" Click="NavAyuda_Click" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ConfigCardStyle}" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <StackPanel>

                            <StackPanel x:Name="PanelImpresion" Visibility="Visible">
                                <TextBlock Text="{DynamicResource SettingsPrinterSection}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,10" />

                                <TextBlock Text="{DynamicResource SettingsPrinterTarget}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <ComboBox x:Name="PrintersComboBox" Height="36" Margin="0,0,0,10" VerticalContentAlignment="Center" FontSize="13" />

                                <TextBlock Text="{DynamicResource SettingsPaperWidth}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <ComboBox x:Name="PaperWidthComboBox" Height="36" Margin="0,0,0,12" VerticalContentAlignment="Center" FontSize="13" SelectionChanged="PaperWidthComboBox_SelectionChanged">
                                    <ComboBoxItem Content="{DynamicResource SettingsPaper58}" IsSelected="True" Tag="32" />
                                    <ComboBoxItem Content="{DynamicResource SettingsPaper80}" Tag="42" />
                                </ComboBox>

                                <RadioButton x:Name="AskBeforePrintCheckBox" GroupName="OpcionesImpresion" Content="{DynamicResource SettingsPrintAsk}" Margin="0,0,0,10" Foreground="{DynamicResource ThemeTextForeground}" />
                                <RadioButton x:Name="AutoPrintCheckBox" GroupName="OpcionesImpresion" Content="{DynamicResource SettingsPrintAuto}" Margin="0,0,0,10" Foreground="{DynamicResource ThemeTextForeground}" />
                                <RadioButton x:Name="NoPrintOrSaveCheckBox" GroupName="OpcionesImpresion" Content="{DynamicResource SettingsPrintNone}" Margin="0,0,0,10" Foreground="{DynamicResource ThemeTextForeground}" />

                                <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,4,0,12" />
                                <TextBlock Text="{DynamicResource SettingsStoreSection}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,10" />

                                <TextBlock Text="{DynamicResource SettingsStoreName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" Margin="2,0,0,4" />
                                <TextBox x:Name="BusinessNameBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" TextChanged="TicketField_TextChanged" />

                                <TextBlock Text="{DynamicResource SettingsStoreSubtitle}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <TextBox x:Name="BusinessSubtitleBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" TextChanged="TicketField_TextChanged" />

                                <TextBlock Text="{DynamicResource SettingsStoreAddress}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <TextBox x:Name="BusinessAddressBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" TextChanged="TicketField_TextChanged" />

                                <TextBlock Text="{DynamicResource SettingsTicketFooter}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <TextBox x:Name="FooterMessageBox" Style="{StaticResource FormTextBoxStyle}" Height="54" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,6" Margin="0,0,0,12" TextChanged="TicketField_TextChanged" />

                            </StackPanel>

                            <StackPanel x:Name="PanelPersonalizacion" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource SettingsAppearanceSection}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,10" />

                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SettingsLanguageTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="{DynamicResource SettingsLanguageDesc}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ComboBox x:Name="CmbIdioma" Grid.Column="1" Width="150" Height="36" VerticalAlignment="Center" SelectionChanged="CmbIdioma_SelectionChanged">
                                            <ComboBoxItem Content="Español" Tag="es" />
                                            <ComboBoxItem Content="English" Tag="en" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SettingsDarkModeTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="{DynamicResource SettingsDarkModeDesc}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="DarkModeCheckBox" Grid.Column="1" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SettingsMetricsModeTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="{DynamicResource SettingsMetricsModeDesc}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ComboBox x:Name="CmbModoMetricas" Grid.Column="1" Width="150" Height="36" VerticalAlignment="Center">
                                            <ComboBoxItem Content="{DynamicResource SettingsMetricsCharts}" Tag="Graficas" />
                                            <ComboBoxItem Content="{DynamicResource SettingsMetricsTables}" Tag="Tablas" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SettingsScaleModeTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="{DynamicResource SettingsScaleModeDesc}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ComboBox x:Name="CmbModoBascula" Grid.Column="1" Width="150" Height="36" VerticalAlignment="Center" SelectionChanged="CmbModoBascula_SelectionChanged">
                                            <ComboBoxItem Content="{DynamicResource SettingsScaleByWeight}" />
                                            <ComboBoxItem Content="{DynamicResource SettingsScaleByPrice}" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource SettingsStandbyTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                                <TextBlock Text="{DynamicResource SettingsStandbyDesc}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox x:Name="StandbyCheckBox" Grid.Column="1" VerticalAlignment="Center" />
                                        </Grid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource SettingsInactivityTime}" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbTiempoReposo" Grid.Column="1" Width="150" Height="36" VerticalAlignment="Center">
                                                <ComboBoxItem Content="{DynamicResource SettingsMin1}" Tag="1" />
                                                <ComboBoxItem Content="{DynamicResource SettingsMin3}" Tag="3" />
                                                <ComboBoxItem Content="{DynamicResource SettingsMin5}" Tag="5" />
                                                <ComboBoxItem Content="{DynamicResource SettingsMin10}" Tag="10" />
                                                <ComboBoxItem Content="{DynamicResource SettingsMin15}" Tag="15" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="LblColorAcentoTitulo" Text="{DynamicResource SettingsAccentTitle}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,20,0,4" />
                                <TextBlock x:Name="LblColorAcentoDesc" Text="{DynamicResource SettingsAccentDesc}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Width="34" Height="34" Margin="0,0,10,0" Cursor="Hand" Tag="#007AFF" Click="ColorButton_Click" ToolTip="Azul Clasico">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#007AFF" CornerRadius="4" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="34" Height="34" Margin="0,0,10,0" Cursor="Hand" Tag="#10B981" Click="ColorButton_Click" ToolTip="Verde Esmeralda">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#10B981" CornerRadius="4" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="34" Height="34" Margin="0,0,10,0" Cursor="Hand" Tag="#8B5CF6" Click="ColorButton_Click" ToolTip="Morado Neon">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#8B5CF6" CornerRadius="4" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="34" Height="34" Margin="0,0,10,0" Cursor="Hand" Tag="#F97316" Click="ColorButton_Click" ToolTip="Naranja Vibrante">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#F97316" CornerRadius="4" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="34" Height="34" Margin="0,0,10,0" Cursor="Hand" Tag="#E11D48" Click="ColorButton_Click" ToolTip="Rojo Carmesi">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#E11D48" CornerRadius="4" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="34" Height="34" Margin="0,0,10,0" Cursor="Hand" Tag="#EC4899" Click="ColorButton_Click" ToolTip="Rosa">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#EC4899" CornerRadius="4" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="34" Height="34" Margin="0,0,10,0" Cursor="Hand" Tag="#3F3F46" Click="ColorButton_Click" ToolTip="Gris Elegante">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#3F3F46" CornerRadius="4" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="PanelBascula" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource SettingsScaleSection}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,6" />
                                <TextBlock Text="{DynamicResource SettingsScaleSub}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,0,0,12" />

                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SettingsScaleEnable}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="{DynamicResource SettingsScaleEnableDesc}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="EnableScaleCheckBox" Grid.Column="1" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="{DynamicResource SettingsScalePort}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ScalePortComboBox" Height="36" VerticalContentAlignment="Center" FontSize="13" />
                                    <Button Grid.Column="2" Content="{DynamicResource SettingsDetectBtn}" Height="36" Padding="14,0" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Cursor="Hand" Click="RefreshScalePorts_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="DetectBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DetectBorder" Property="Opacity" Value="0.9" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="DetectBorder" Property="Opacity" Value="0.8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource SettingsScaleBaud}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                        <ComboBox x:Name="ScaleBaudRateComboBox" Height="36" VerticalContentAlignment="Center" FontSize="13">
                                            <ComboBoxItem Content="{DynamicResource SettingsBaud9600}" IsSelected="True" Tag="9600" />
                                            <ComboBoxItem Content="{DynamicResource SettingsBaud2400}" Tag="2400" />
                                            <ComboBoxItem Content="4800" Tag="4800" />
                                            <ComboBoxItem Content="19200" Tag="19200" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource SettingsScaleProto}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                        <ComboBox x:Name="ScaleProtocolComboBox" Height="36" VerticalContentAlignment="Center" FontSize="13">
                                            <ComboBoxItem Content="{DynamicResource SettingsProtoTorrey}" IsSelected="True" />
                                            <ComboBoxItem Content="{DynamicResource SettingsProtoContinuous}" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SettingsScaleTestTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock x:Name="ScaleTestResultText" Text="{DynamicResource SettingsScaleTestHint}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{DynamicResource SettingsScaleTest}" Height="36" Padding="16,0" Background="{DynamicResource ThemeAccent}" Foreground="White" BorderThickness="0" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Bold" Cursor="Hand" Click="TestScale_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="TestBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="TestBorder" Property="Opacity" Value="0.9" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="TestBorder" Property="Opacity" Value="0.8" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="PanelServidorLocal" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource SettingsServerTitle}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,6" />
                                <TextBlock Text="{DynamicResource SettingsServerDesc}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,0,0,12" />

                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SettingsServerEnable}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="{DynamicResource SettingsServerEnableDesc}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                        </StackPanel>
