<UserControl x:Class="Punto_de_Venta.Configuracion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="960" MinHeight="600"
        Background="Transparent"
        Focusable="True"
        IsVisibleChanged="UserControl_IsVisibleChanged"
        PreviewKeyDown="UserControl_PreviewKeyDown"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SystemGreen" Color="#34C759" />

        <Style x:Key="ConfigCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Effect" Value="{StaticResource FluentShadow}" />
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,10,24,18" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configuracion" Visibility="Collapsed" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition x:Name="PreviewColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ConfigCardStyle}" Padding="12,14">
                <StackPanel>
                    <TextBlock Text="AJUSTES" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" Margin="8,0,0,10" />
                    <Button x:Name="NavImpresionBtn" Content="🖨️  Impresion" Style="{StaticResource SidebarButtonStyle}" Click="NavImpresion_Click" />
                    <Button x:Name="NavPersonalizacionBtn" Content="🎨  Personalizacion" Style="{StaticResource SidebarButtonStyle}" Click="NavPersonalizacion_Click" />
                    <Button x:Name="NavBasculaBtn" Content="⚖️  Bascula digital" Style="{StaticResource SidebarButtonStyle}" Click="NavBascula_Click" />
                    <Button x:Name="NavServidorLocalBtn" Content="🌐  Servidor Local" Style="{StaticResource SidebarButtonStyle}" Click="NavServidorLocal_Click" />
                    <Button x:Name="NavWhatsAppBtn" Content="📱  WhatsApp" Style="{StaticResource SidebarButtonStyle}" Click="NavWhatsApp_Click" />
                    <Button x:Name="NavSeguridadBtn" Content="🛡️  Caja y Seguridad" Style="{StaticResource SidebarButtonStyle}" Click="NavSeguridad_Click" />
                    <Button x:Name="NavAtajosBtn" Content="⌨️  Atajos de teclado" Style="{StaticResource SidebarButtonStyle}" Click="NavAtajos_Click" />
                    <Button x:Name="NavAyudaBtn" Content="❓  Ayuda y Soporte" Style="{StaticResource SidebarButtonStyle}" Click="NavAyuda_Click" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ConfigCardStyle}" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <StackPanel>

                            <StackPanel x:Name="PanelImpresion" Visibility="Visible">
                                <TextBlock Text="Impresora" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,10" />

                                <TextBlock Text="Impresora destino" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <ComboBox x:Name="PrintersComboBox" Height="36" Margin="0,0,0,10" VerticalContentAlignment="Center" FontSize="13" />

                                <TextBlock Text="Ancho de papel" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <ComboBox x:Name="PaperWidthComboBox" Height="36" Margin="0,0,0,12" VerticalContentAlignment="Center" FontSize="13" SelectionChanged="PaperWidthComboBox_SelectionChanged">
                                    <ComboBoxItem Content="58 mm estandar (32 columnas)" IsSelected="True" Tag="32" />
                                    <ComboBoxItem Content="80 mm ancho (42 columnas)" Tag="42" />
                                </ComboBox>

                                <RadioButton x:Name="AskBeforePrintCheckBox" GroupName="OpcionesImpresion" Content="Preguntar antes de imprimir" Margin="0,0,0,10" Foreground="{DynamicResource ThemeTextForeground}" />
                                <RadioButton x:Name="AutoPrintCheckBox" GroupName="OpcionesImpresion" Content="Imprimir ticket automaticamente" Margin="0,0,0,10" Foreground="{DynamicResource ThemeTextForeground}" />
                                <RadioButton x:Name="NoPrintOrSaveCheckBox" GroupName="OpcionesImpresion" Content="No imprimir ni guardar ticket" Margin="0,0,0,10" Foreground="{DynamicResource ThemeTextForeground}" />

                                <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,4,0,12" />
                                <TextBlock Text="Datos de la Tienda (Identidad Visual)" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,10" />

                                <TextBlock Text="Nombre de la tienda (Ticket y Pantalla Principal)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" Margin="2,0,0,4" />
                                <TextBox x:Name="BusinessNameBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" TextChanged="TicketField_TextChanged" />

                                <TextBlock Text="Subtitulo / Giro" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <TextBox x:Name="BusinessSubtitleBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" TextChanged="TicketField_TextChanged" />

                                <TextBlock Text="Direccion" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <TextBox x:Name="BusinessAddressBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" TextChanged="TicketField_TextChanged" />

                                <TextBlock Text="Mensaje al pie del ticket" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <TextBox x:Name="FooterMessageBox" Style="{StaticResource FormTextBoxStyle}" Height="54" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,6" Margin="0,0,0,12" TextChanged="TicketField_TextChanged" />

                            </StackPanel>

                            <StackPanel x:Name="PanelPersonalizacion" Visibility="Collapsed">
                                <TextBlock Text="Apariencia y Tema" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,10" />

                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Modo oscuro" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="Atenua la interfaz para trabajar con poca luz (se aplica al guardar)" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="DarkModeCheckBox" Grid.Column="1" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Modo de bascula (F8)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="Elige como se abre la ventana de pesaje por defecto" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ComboBox x:Name="CmbModoBascula" Grid.Column="1" Width="150" Height="36" VerticalAlignment="Center" SelectionChanged="CmbModoBascula_SelectionChanged">
                                            <ComboBoxItem Content="Por Peso (kg)" />
                                            <ComboBoxItem Content="Por Precio ($)" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Pantalla de reposo automatica" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                                <TextBlock Text="Protege la pantalla principal cuando te alejas del equipo" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox x:Name="StandbyCheckBox" Grid.Column="1" VerticalAlignment="Center" />
                                        </Grid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Tiempo de inactividad" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <ComboBox x:Name="CmbTiempoReposo" Grid.Column="1" Width="150" Height="36" VerticalAlignment="Center">
                                                <ComboBoxItem Content="1 minuto" Tag="1" />
                                                <ComboBoxItem Content="3 minutos" Tag="3" />
                                                <ComboBoxItem Content="5 minutos" Tag="5" />
                                                <ComboBoxItem Content="10 minutos" Tag="10" />
                                                <ComboBoxItem Content="15 minutos" Tag="15" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="LblColorAcentoTitulo" Text="Color de Acento" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,20,0,4" />
                                <TextBlock x:Name="LblColorAcentoDesc" Text="Elige el color principal para los botones, selecciones y resaltados del sistema." FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Width="34" Height="34" Margin="0,0,10,0" Cursor="Hand" Tag="#007AFF" Click="ColorButton_Click" ToolTip="Azul Clasico">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#007AFF" CornerRadius="4" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="34" Height="34" Margin="0,0,10,0" Cursor="Hand" Tag="#10B981" Click="ColorButton_Click" ToolTip="Verde Esmeralda">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#10B981" CornerRadius="4" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="34" Height="34" Margin="0,0,10,0" Cursor="Hand" Tag="#8B5CF6" Click="ColorButton_Click" ToolTip="Morado Neon">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#8B5CF6" CornerRadius="4" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="34" Height="34" Margin="0,0,10,0" Cursor="Hand" Tag="#F97316" Click="ColorButton_Click" ToolTip="Naranja Vibrante">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#F97316" CornerRadius="4" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="34" Height="34" Margin="0,0,10,0" Cursor="Hand" Tag="#E11D48" Click="ColorButton_Click" ToolTip="Rojo Carmesi">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#E11D48" CornerRadius="4" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="34" Height="34" Margin="0,0,10,0" Cursor="Hand" Tag="#EC4899" Click="ColorButton_Click" ToolTip="Rosa">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#EC4899" CornerRadius="4" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="34" Height="34" Margin="0,0,10,0" Cursor="Hand" Tag="#3F3F46" Click="ColorButton_Click" ToolTip="Gris Elegante">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#3F3F46" CornerRadius="4" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="PanelBascula" Visibility="Collapsed">
                                <TextBlock Text="Bascula Digital (Puerto Serie RS-232)" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,6" />
                                <TextBlock Text="Permite pesar articulos a granel automaticamente desde la pantalla de cobro." FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,0,0,12" />

                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Habilitar bascula en el sistema" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="Activa la lectura de peso al escanear o presionar F8 en cobro" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="EnableScaleCheckBox" Grid.Column="1" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="Puerto de conexion (COM)" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ScalePortComboBox" Height="36" VerticalContentAlignment="Center" FontSize="13" />
                                    <Button Grid.Column="2" Content="🔄 Detectar" Height="36" Padding="14,0" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Cursor="Hand" Click="RefreshScalePorts_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="DetectBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DetectBorder" Property="Opacity" Value="0.9" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="DetectBorder" Property="Opacity" Value="0.8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Velocidad (Baud Rate)" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                        <ComboBox x:Name="ScaleBaudRateComboBox" Height="36" VerticalContentAlignment="Center" FontSize="13">
                                            <ComboBoxItem Content="9600 (Estandar Torrey / Rhino)" IsSelected="True" Tag="9600" />
                                            <ComboBoxItem Content="2400 (Basculas clasicas)" Tag="2400" />
                                            <ComboBoxItem Content="4800" Tag="4800" />
                                            <ComboBoxItem Content="19200" Tag="19200" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Protocolo de lectura" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                        <ComboBox x:Name="ScaleProtocolComboBox" Height="36" VerticalContentAlignment="Center" FontSize="13">
                                            <ComboBoxItem Content="Torrey / Rhino (Peticion P)" IsSelected="True" />
                                            <ComboBoxItem Content="Modo Continuo" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Prueba de lectura en tiempo real" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock x:Name="ScaleTestResultText" Text="Coloca un objeto sobre la bascula y presiona probar" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Probar Bascula" Height="36" Padding="16,0" Background="{DynamicResource ThemeAccent}" Foreground="White" BorderThickness="0" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Bold" Cursor="Hand" Click="TestScale_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="TestBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="TestBorder" Property="Opacity" Value="0.9" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="TestBorder" Property="Opacity" Value="0.8" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="PanelServidorLocal" Visibility="Collapsed">
                                <TextBlock Text="Servidor Local (Acceso Movil)" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,6" />
                                <TextBlock Text="Conecta dispositivos moviles en la misma red Wi-Fi para auditar y consultar inventario." FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,0,0,12" />

                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Habilitar servidor local" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="Permite que otros dispositivos en tu red local se conecten al inventario (se aplica al guardar)" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="EnableLocalServerCheckBox" Grid.Column="1" VerticalAlignment="Center" Cursor="Hand" />
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Estado del servicio" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,4" />
                                        <TextBlock x:Name="TxtEstadoServidor" Text="Estado: Verificando..." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Direccion IP de esta computadora" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDireccionIp" Style="{StaticResource FormTextBoxStyle}" IsReadOnly="True" />
