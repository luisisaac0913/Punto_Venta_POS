<UserControl x:Class="Punto_de_Venta.Promociones"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="900" MinHeight="540"
             Background="Transparent"
             Focusable="True"
             IsVisibleChanged="UserControl_IsVisibleChanged"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#08000000"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForeground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="Transparent" ClipToBounds="True">
        <Grid MouseLeftButtonDown="Grid_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource PromosTitle}" Visibility="Collapsed" />
            </Grid>

            <Grid Grid.Row="1" Margin="32,20,32,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}" Padding="10">
                    <DataGrid x:Name="PromocionesGrid" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Nombre}" Width="2*">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource PosColName}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Tipo}" Width="1*">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource PromosColType}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding VigenciaTexto}" Width="1.3*">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource PromosColValidity}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="80">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{DynamicResource PromosColActive}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Activa, Mode=TwoWay}" 
                                                  Click="ToggleActiva_Click" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{DynamicResource PromosColActions}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✏️" FontSize="14" ToolTip="Editar" Style="{StaticResource FluentButtonSubtle}" Width="32" Height="32" Padding="0" Cursor="Hand" Margin="0,0,6,0" Click="EditarPromo_Click"/>
                                            <Button Content="🗑️" FontSize="14" ToolTip="Eliminar" Style="{StaticResource FluentButtonSubtle}" Width="32" Height="32" Padding="0" Cursor="Hand" Click="EliminarPromo_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource FluentCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="TituloFormularioText" Text="{DynamicResource PromosNewTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,14" />

                        <TextBlock Text="{DynamicResource PromosNameLabel}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                        <TextBox x:Name="NombrePromoBox" Margin="0,0,0,12" />

                        <TextBlock Text="{DynamicResource PromosTypeLabel}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                        <ComboBox x:Name="TipoPromoCombo" Margin="0,0,0,12" SelectionChanged="TipoPromoCombo_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource PromosTypeVolume}" IsSelected="True" Tag="Volumen" />
                            <ComboBoxItem Content="{DynamicResource PromosTypeCombo}" Tag="Combo" />
                            <ComboBoxItem Content="{DynamicResource PromosTypeSecond}" Tag="PorcentajeSegundo" />
                            <ComboBoxItem Content="{DynamicResource PromosTypeWholesale}" Tag="Mayoreo" />
                        </ComboBox>

                        <TextBlock x:Name="LabelProd1" Text="{DynamicResource PromosMainProdId}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                        <TextBox x:Name="ProdId1Box" Margin="0,0,0,12" />

                        <StackPanel x:Name="PanelProducto2" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource PromosSecondProdId}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                            <TextBox x:Name="ProdId2Box" />
                        </StackPanel>

                        <Grid x:Name="PanelVolumen" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource PromosMinQty}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <TextBox x:Name="CantidadMinBox" Text="3" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource PromosSpecialPrice}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <TextBox x:Name="PrecioEspecialBox" Text="0.00" />
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="PanelPrecioCombo" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource PromosComboPrice}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                            <TextBox x:Name="PrecioComboTotalBox" Text="0.00" />
                        </StackPanel>

                        <StackPanel x:Name="PanelPorcentaje" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource PromosDiscountPct}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                            <TextBox x:Name="PorcentajeDescuentoBox" Text="50" />
                        </StackPanel>

                        <CheckBox x:Name="ChkTiempoLimite" Content="{DynamicResource PromosLimitTime}" Margin="2,2,0,10" Checked="ChkTiempoLimite_Changed" Unchecked="ChkTiempoLimite_Changed" />

                        <Grid x:Name="PanelFechas" Visibility="Collapsed" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource PromosStartDate}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <DatePicker x:Name="FechaInicioPicker" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource PromosEndDate}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <DatePicker x:Name="FechaFinPicker" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnCancelarEdicion" Grid.Column="0" Content="{DynamicResource CommonCancel}" Visibility="Collapsed" Style="{StaticResource FluentButtonSecondary}" Margin="0,0,10,0" Click="CancelarEdicion_Click" />
                            <Button x:Name="BtnGuardarPromo" Grid.Column="1" Content="{DynamicResource PromosSaveBtn}" Style="{StaticResource FluentButtonPrimary}" Click="GuardarPromo_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>