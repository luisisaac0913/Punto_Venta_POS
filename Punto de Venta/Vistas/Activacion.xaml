<UserControl x:Class="Punto_de_Venta.Activacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="MercadoPagoButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#009EE3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,28,32,32" MaxWidth="960" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Border x:Name="PanelLicenciaActiva" Visibility="Collapsed"
                    Background="{DynamicResource ThemeSurfaceBackground}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1" CornerRadius="8" Padding="36"
                    Effect="{StaticResource FluentCardShadow}"
                    HorizontalAlignment="Center" MaxWidth="580">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Imagenes/CHC_logo.png" 
                           Width="150" Height="78" 
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Chip&amp;Chapa" FontSize="18" FontWeight="Bold" 
                               Foreground="{DynamicResource ThemeTextForeground}" 
                               FontFamily="Segoe UI Variable, Segoe UI" 
                               HorizontalAlignment="Center" Margin="0,0,0,18" />

                    <Border Width="56" Height="56" CornerRadius="4" 
                            Background="#1510B981" BorderBrush="#3510B981" BorderThickness="1" 
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="&#x2713;" FontSize="28" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Licencia Premium Activa" FontSize="22" FontWeight="Bold" 
                               Foreground="{DynamicResource ThemeTextForeground}" 
                               FontFamily="Segoe UI Variable, Segoe UI"
                               HorizontalAlignment="Center" Margin="0,0,0,6" />

                    <TextBlock Text="Tu equipo esta registrado y cuenta con todas las funciones desbloqueadas de forma vitalicia." 
                               FontSize="13" Foreground="{DynamicResource ThemeMutedForeground}" 
                               FontFamily="Segoe UI Variable, Segoe UI"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24" LineHeight="18" />

                    <Border Background="{DynamicResource ThemeInputBackground}" 
                            BorderBrush="{DynamicResource ThemeBorder}" 
                            BorderThickness="1" CornerRadius="4" Padding="18,14" Margin="0,0,0,24">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Estatus:" Foreground="{DynamicResource ThemeMutedForeground}" FontSize="12" />
                                <TextBlock Text="Validado en la nube" FontWeight="Bold" Foreground="#10B981" FontSize="12" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Plan:" Foreground="{DynamicResource ThemeMutedForeground}" FontSize="12" />
                                <TextBlock Text="Vitalicio (Sin mensualidades)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" FontSize="12" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Identificador (HWID):" Foreground="{DynamicResource ThemeMutedForeground}" FontSize="12" />
                                <TextBlock x:Name="TxtHwidActivo" Text="-" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" FontSize="11" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="Continuar al sistema" Height="36" Width="200"
                            Style="{StaticResource FluentButtonPrimary}"
                            Click="BtnVolver_Click" />
                </StackPanel>
            </Border>

            <Border x:Name="PanelLicenciaInactiva" Visibility="Visible"
                    Background="{DynamicResource ThemeSurfaceBackground}" 
                    BorderBrush="{DynamicResource ThemeBorder}" 
                    BorderThickness="1" CornerRadius="8" Padding="28,24"
                    Effect="{StaticResource FluentCardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Left" Margin="0,0,0,16">
                            <Image Source="pack://application:,,,/Imagenes/CHC_logo.png" 
                                   Width="130" Height="68" 
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True"
                                   UseLayoutRounding="True"
                                   HorizontalAlignment="Left" Margin="0,0,0,6" />
                            <TextBlock Text="Chip&amp;Chapa" FontSize="16" FontWeight="Bold" 
                                       Foreground="{DynamicResource ThemeTextForeground}" 
                                       FontFamily="Segoe UI Variable, Segoe UI" 
                                       HorizontalAlignment="Left" />
                        </StackPanel>

                        <TextBlock Text="Activar Version Premium" FontSize="22" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeTextForeground}" 
                                   FontFamily="Segoe UI Variable, Segoe UI" Margin="0,0,0,4" />

                        <TextBlock Text="Obten acceso permanente a todas las herramientas avanzadas sin rentas ni pagos mensuales." 
                                   FontSize="13" Foreground="{DynamicResource ThemeMutedForeground}" 
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="18" />

                        <TextBlock Text="FUNCIONES INCLUIDAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,0,0,12" />

                        <StackPanel Margin="0,0,0,18">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#x2713;" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="13" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Integracion con Bascula (F8), apertura de cajon y ventas en espera (F2)" FontSize="12" Foreground="{DynamicResource ThemeTextForeground}" TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#x2713;" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="13" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Modulo completo de Fiado: cuentas por cobrar, abonos y cobranza por WhatsApp" FontSize="12" Foreground="{DynamicResource ThemeTextForeground}" TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#x2713;" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="13" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Inteligencia de negocio: utilidades reales, margenes y exportacion a Excel y PDF" FontSize="12" Foreground="{DynamicResource ThemeTextForeground}" TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#x2713;" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="13" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Gestion de lotes, precios de mayoreo e impresion de etiquetas con codigos de barra" FontSize="12" Foreground="{DynamicResource ThemeTextForeground}" TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#x2713;" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="13" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Promociones y ofertas automaticas configurables (descuentos y 2x1)" FontSize="12" Foreground="{DynamicResource ThemeTextForeground}" TextWrapping="Wrap" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#x2713;" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="13" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Seguridad con PIN de administrador y respaldos automaticos en Google Drive" FontSize="12" Foreground="{DynamicResource ThemeTextForeground}" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Licencia vitalicia para este equipo • Sin pagos recurrentes" 
                                   FontSize="11" Foreground="{DynamicResource ThemeMutedForeground}" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="{DynamicResource ThemeInputBackground}" 
                            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="22,20" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="PRECIO DE LICENCIA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" HorizontalAlignment="Center" Margin="0,0,0,6" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                <TextBlock Text="$" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Top" Margin="0,4,2,0" />
                                <TextBlock Text="999" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" FontFamily="Segoe UI Variable, Segoe UI" />
                                <TextBlock Text=".00 MXN" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" VerticalAlignment="Bottom" Margin="4,0,0,8" />
                            </StackPanel>

                            <TextBlock Text="Pago unico y definitivo" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,16" />

                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="ID de Hardware:" FontSize="10" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,0,0,2" />
                                        <TextBlock x:Name="TxtHwidInactivo" Text="Detectando..." FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource ThemeTextForeground}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Copiar" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                            Style="{StaticResource FluentButtonSecondary}"
                                            Height="28" Padding="10,0"
                                            FontSize="11" FontWeight="SemiBold" Click="BtnCopiarHwid_Click" />
                                </Grid>
                            </Border>

                            <StackPanel x:Name="PanelPago">
                                <Button x:Name="BtnPagarMercadoPago" Style="{StaticResource MercadoPagoButtonStyle}" Click="BtnPagarMercadoPago_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Pagar con Mercado Pago" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="Tarjetas de debito, credito, SPEI y OXXO." FontSize="11" Foreground="{DynamicResource ThemeMutedForeground}" TextAlignment="Center" Margin="0,8,0,0" />

                                <TextBlock Text="🔒 Pago seguro encriptado con activacion automatica" FontSize="11" Foreground="{DynamicResource ThemeMutedForeground}" TextAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel x:Name="PanelEspera" Visibility="Collapsed" Margin="0,4,0,0">
                                <ProgressBar Height="4" IsIndeterminate="True" 
                                             Foreground="#009EE3" 
                                             Background="{DynamicResource ThemeWindowBackground}" 
                                             BorderThickness="0" Margin="0,0,0,12" />

                                <TextBlock x:Name="TxtEstadoEspera" 
                                           Text="Esperando confirmacion..." 
                                           FontSize="12" FontWeight="Bold" 
                                           Foreground="{DynamicResource ThemeTextForeground}" 
                                           HorizontalAlignment="Center" Margin="0,0,0,4" />

                                <TextBlock Text="Completa tu pago en el navegador. La activacion se confirmara automaticamente." 
                                           FontSize="11" Foreground="{DynamicResource ThemeMutedForeground}" 
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14" LineHeight="15" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="BtnReabrirLink" Content="Reabrir enlace" 
                                            Style="{StaticResource FluentButtonSubtle}"
                                            Foreground="#009EE3"
                                            Height="30" Padding="8,0"
                                            FontSize="11" FontWeight="Bold" Margin="0,0,12,0"
                                            Click="BtnReabrirLink_Click" />

                                    <Button Content="Cancelar" 
                                            Style="{StaticResource FluentButtonSubtle}"
                                            Height="30" Padding="8,0"
                                            Foreground="{DynamicResource ThemeMutedForeground}" 
                                            FontSize="11" FontWeight="Medium"
                                            Click="BtnCancelarEspera_Click" />
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="OverlayVideoAcreditado" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource ThemeSurfaceBackground}" 
                        BorderBrush="{DynamicResource ThemeBorder}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="24"
                        Effect="{StaticResource FluentModalShadow}"
                        MaxWidth="640">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Pago Acreditado Exitosamente" FontSize="20" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeTextForeground}" 
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   HorizontalAlignment="Center" Margin="0,0,0,14" />

                        <Border CornerRadius="8" ClipToBounds="True" Background="Transparent" Width="580" Height="326">
                            <MediaElement x:Name="VideoAcreditado" 
                                          LoadedBehavior="Manual" 
                                          UnloadedBehavior="Stop" 
                                          Stretch="UniformToFill" 
                                          MediaEnded="VideoAcreditado_MediaEnded" 
                                          MediaFailed="VideoAcreditado_MediaFailed" />
                        </Border>

                        <Button Content="Continuar" Height="36" Width="180" Margin="0,18,0,0"
                                Style="{StaticResource FluentButtonPrimary}"
                                Click="BtnSaltarVideo_Click" />
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
