<UserControl x:Class="Punto_de_Venta.Activacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>
        <DropShadowEffect x:Key="CardElevation" BlurRadius="30" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.06" />
        <DropShadowEffect x:Key="HoverElevation" BlurRadius="15" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40,24,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Volver al menu" 
                        Height="36" Padding="12,0" 
                        Background="Transparent" 
                        Foreground="{DynamicResource ThemeTextForeground}" 
                        BorderThickness="0" Cursor="Hand" 
                        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" FontWeight="SemiBold"
                        Click="BtnVolver_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="BadgeEstadoHeader" Background="#1510B981" BorderThickness="0" CornerRadius="12" Padding="14,6">
                        <TextBlock x:Name="TxtEstadoHeader" Text="Licencia Activa" Foreground="#10B981" FontSize="12" FontWeight="Bold" />
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="920">

                <Border x:Name="PanelLicenciaActiva" Visibility="Collapsed"
                        Background="{DynamicResource ThemeSurfaceBackground}" 
                        BorderBrush="{DynamicResource ThemeBorder}" 
                        BorderThickness="1" CornerRadius="24" Padding="50" 
                        Effect="{StaticResource CardElevation}" Width="650">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="80" Height="80" CornerRadius="40" 
                                Background="#1510B981" BorderThickness="0" 
                                HorizontalAlignment="Center" Margin="0,0,0,24">
                            <TextBlock Text="&#x2713;" FontSize="38" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Licencia Premium Activa" FontSize="28" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeTextForeground}" 
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <TextBlock Text="Tu sistema esta operando con todas las funciones desbloqueadas. La licencia esta enlazada permanentemente a este hardware." 
                                   FontSize="14" Foreground="{DynamicResource ThemeMutedForeground}" 
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,32" MaxWidth="450"/>

                        <Border Background="{DynamicResource ThemeInputBackground}" 
                                BorderBrush="{DynamicResource ThemeBorder}" 
                                BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,32">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="Estado:" FontWeight="Medium" Foreground="{DynamicResource ThemeMutedForeground}" FontSize="13"/>
                                    <TextBlock Text="Validado en la nube" FontWeight="Bold" Foreground="#10B981" FontSize="13" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="Plan:" FontWeight="Medium" Foreground="{DynamicResource ThemeMutedForeground}" FontSize="13"/>
                                    <TextBlock Text="Vitalicio (Sin mensualidades)" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" FontSize="13" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="HWID Vinculado:" FontWeight="Medium" Foreground="{DynamicResource ThemeMutedForeground}" FontSize="13"/>
                                    <TextBlock x:Name="TxtHwidActivo" Text="-" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" FontSize="13" HorizontalAlignment="Right" Opacity="0.8"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Content="Regresar al sistema" Height="50" Width="220"
                                Background="{DynamicResource ThemeTextForeground}" Foreground="{DynamicResource ThemeSurfaceBackground}" 
                                FontWeight="Bold" FontSize="14" BorderThickness="0" 
                                Cursor="Hand" Click="BtnVolver_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="25">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <Border x:Name="PanelLicenciaInactiva" Visibility="Visible"
                        Background="{DynamicResource ThemeSurfaceBackground}" 
                        BorderBrush="{DynamicResource ThemeBorder}" 
                        BorderThickness="1" CornerRadius="28" Padding="12" 
                        Effect="{StaticResource CardElevation}" MaxWidth="880">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="32,40,32,40" VerticalAlignment="Center">
                            <TextBlock Text="&#x2728;" FontSize="28" Margin="0,0,0,12"/>
                            <TextBlock Text="Eleva tu negocio" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,6"/>
                            <TextBlock Text="Desbloquea herramientas avanzadas para controlar tu inventario, evitar fugas de dinero y cobrar mas rapido." 
                                       FontSize="13" Foreground="{DynamicResource ThemeMutedForeground}" TextWrapping="Wrap" Margin="0,0,0,32" LineHeight="20"/>

                            <TextBlock Text="Beneficios Premium" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Opacity="0.6" Margin="0,0,0,16" TextTrimming="CharacterEllipsis"/>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#x2713;" Foreground="#007AFF" FontWeight="Bold" FontSize="14" Margin="0,0,12,0"/>
                                    <TextBlock Text="Bascula, cajon de dinero y ventas en espera" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ThemeTextForeground}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#x2713;" Foreground="#007AFF" FontWeight="Bold" FontSize="14" Margin="0,0,12,0"/>
                                    <TextBlock Text="Libreta de fiado digital y cuentas por cobrar" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ThemeTextForeground}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#x2713;" Foreground="#007AFF" FontWeight="Bold" FontSize="14" Margin="0,0,12,0"/>
                                    <TextBlock Text="Analisis de utilidades y graficas de negocio" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ThemeTextForeground}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#x2713;" Foreground="#007AFF" FontWeight="Bold" FontSize="14" Margin="0,0,12,0"/>
                                    <TextBlock Text="Gestion de lotes e impresion de etiquetas" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ThemeTextForeground}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2713;" Foreground="#007AFF" FontWeight="Bold" FontSize="14" Margin="0,0,12,0"/>
                                    <TextBlock Text="Proteccion de datos (PIN) y nube automatica" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ThemeTextForeground}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Background="{DynamicResource ThemeInputBackground}" 
                                CornerRadius="20" Padding="32" Effect="{StaticResource HoverElevation}">
                            <StackPanel VerticalAlignment="Center">
                                
                                <TextBlock Text="Pago Unico" FontSize="12" FontWeight="SemiBold" Foreground="#007AFF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                    <TextBlock Text="$" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Top" Margin="0,6,2,0"/>
                                    <TextBlock Text="999" FontSize="42" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}"/>
                                    <TextBlock Text=".00 MXN" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedForeground}" VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                                </StackPanel>
                                
                                <TextBlock Text="Licencia vitalicia. Sin cuotas ocultas." FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" HorizontalAlignment="Center" Margin="0,0,0,32"/>

                                <Border Background="{DynamicResource ThemeWindowBackground}" BorderThickness="0" CornerRadius="12" Padding="16,12" Margin="0,0,0,24">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Identificador de Hardware:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="TxtHwidInactivo" Text="Detectando..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}"/>
                                        </StackPanel>
                                        <Button Content="Copiar" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                                Background="Transparent" BorderThickness="0" Foreground="#007AFF" 
                                                FontSize="11" FontWeight="Bold" Cursor="Hand" Click="BtnCopiarHwid_Click"/>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="PanelPago">
                                    <Button x:Name="BtnPagarMercadoPago" Height="50" 
                                            Background="#009EE3" Foreground="White" 
                                            FontWeight="Bold" FontSize="14" BorderThickness="0" 
                                            Cursor="Hand" Click="BtnPagarMercadoPago_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="25">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="&#x1F4B3;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Comprar" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock Text="Transaccion segura encriptada" FontSize="11" Foreground="{DynamicResource ThemeMutedForeground}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                </StackPanel>

                                <StackPanel x:Name="PanelEspera" Visibility="Collapsed" Margin="0,10,0,0">
                                    <ProgressBar Height="4" IsIndeterminate="True" 
                                                 Foreground="#007AFF" 
                                                 Background="{DynamicResource ThemeWindowBackground}" 
                                                 BorderThickness="0" Margin="0,0,0,16"/>

                                    <TextBlock x:Name="TxtEstadoEspera" 
                                               Text="Esperando confirmacion..." 
                                               FontSize="13" FontWeight="Bold" 
                                               Foreground="{DynamicResource ThemeTextForeground}" 
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                    <TextBlock Text="Completa la transaccion en tu navegador." 
                                               FontSize="11" Foreground="{DynamicResource ThemeMutedForeground}" 
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="BtnReabrirLink" Content="Reabrir enlace" 
                                                Background="Transparent" Foreground="#007AFF" 
                                                BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Margin="0,0,16,0"
                                                Click="BtnReabrirLink_Click"/>
                                        <Button Content="Cancelar" 
                                                Background="Transparent" Foreground="{DynamicResource ThemeMutedForeground}" 
                                                BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="Medium"
                                                Click="BtnCancelarEspera_Click"/>
                                    </StackPanel>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>