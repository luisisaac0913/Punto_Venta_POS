<UserControl x:Class="Punto_de_Venta.Vistas.Cobro"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             MinWidth="1000" MinHeight="640"
             Focusable="True"
             IsVisibleChanged="UserControl_IsVisibleChanged"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             Loaded="UserControl_Loaded"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border" BasedOn="{StaticResource FluentCardStyle}" />

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#AEAEB2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentedToggleStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegBorder" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,6" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegBorder" Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
                                <Setter TargetName="SegBorder" Property="Effect" Value="{StaticResource FluentShadow}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShortcutTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForeground}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>
    </UserControl.Resources>

    <Border Background="Transparent" ClipToBounds="True">
        <Grid>
            <Grid Margin="32,20,32,24" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Cobro" Visibility="Collapsed" />

                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                        <TextBlock Text="Buscar producto" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedForeground}" Margin="4,0,0,6" />

                        <Border x:Name="SearchBorder" Height="40" Style="{StaticResource FluentInputContainerStyle}" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="{DynamicResource ThemeMutedForeground}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                <Grid Grid.Column="1">
                                    <TextBox x:Name="SearchBox" Style="{StaticResource EmbeddedTextBoxStyle}" PreviewKeyDown="SearchBox_PreviewKeyDown" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" Foreground="{DynamicResource ThemeTextForeground}" VerticalContentAlignment="Center" CaretBrush="{DynamicResource ThemeAccent}" TextChanged="SearchBox_TextChanged" />
                                    <TextBlock x:Name="SearchPlaceholder" Text="id, nombre... (Ctrl+← / Tab para enfocar)" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" Foreground="{DynamicResource ThemeMutedForeground}" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=SearchBorder}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" Width="{Binding ActualWidth, ElementName=SearchBorder}" IsOpen="False">
                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,8" Effect="{StaticResource FluentModalShadow}">
                                <ListBox x:Name="SuggestionsList" Background="Transparent" BorderThickness="0" MaxHeight="300" Focusable="False" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="MinHeight" Value="54" />
                                            <Setter Property="Padding" Value="10,6" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="SuggestionBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="SuggestionBorder" Property="Background" Value="{DynamicResource ThemeAccent}" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="SuggestionBorder" Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="SuggestionItem_MouseLeftButtonUp" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtNombre" Text="{Binding Nombre}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                                    <TextBlock x:Name="TxtCodigo" Text="{Binding Codigo, StringFormat=Codigo: \{0\}}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <Border x:Name="BadgeBorder" Grid.Column="1" CornerRadius="4" Padding="6,2" Margin="10,0" VerticalAlignment="Center" Background="{DynamicResource ThemeInputBackground}">
                                                    <TextBlock x:Name="TxtStock" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EsStockBajo}" Value="True">
                                                                        <Setter Property="Foreground" Value="#B45309" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding EsStockAgotado}" Value="True">
                                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="{Binding Stock}" />
                                                    </TextBlock>
                                                </Border>

                                                <TextBlock x:Name="TxtPrecio" Grid.Column="2" Text="{Binding Precio, StringFormat={}{0:C2}}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="TxtNombre" Property="Foreground" Value="White" />
                                                    <Setter TargetName="TxtCodigo" Property="Foreground" Value="#E5FFFFFF" />
                                                    <Setter TargetName="TxtPrecio" Property="Foreground" Value="White" />
                                                    <Setter TargetName="TxtStock" Property="Foreground" Value="White" />
                                                    <Setter TargetName="BadgeBorder" Property="Background" Value="#33FFFFFF" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                        <TextBlock x:Name="SearchMessage" Text="" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SystemRed}" Margin="6,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,1">
                        <Button x:Name="BtnVentasEnEsperaBadge" Height="36" Padding="12,0" Background="#15007AFF" BorderBrush="#30007AFF" BorderThickness="1" Cursor="Hand" Click="BtnVentasEnEspera_Click" ToolTip="Ver ventas en espera o pausar venta actual (F2)" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtVentasEsperaBadge" Text="En espera (0)" FontSize="12" FontWeight="SemiBold" Foreground="#007AFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Height="36" Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="4" Padding="14,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Border x:Name="StatusScaleBadge" Background="#15000000" CornerRadius="4" Padding="6,3" Margin="0,0,6,0" ToolTip="Estado de la bascula">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="DotScaleStatus" Width="7" Height="7" Fill="#8E8E93" Margin="0,0,4,0" />
                                            <TextBlock Text="⚖️" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="StatusPrinterBadge" Background="#15000000" CornerRadius="4" Padding="6,3" Margin="0,0,10,0" ToolTip="Estado de la impresora termica">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="DotPrinterStatus" Width="7" Height="7" Fill="#8E8E93" Margin="0,0,4,0" />
                                            <TextBlock Text="🖨️" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SystemGreen}" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ClockText" Text="6:08 PM" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                            <Border Style="{StaticResource CardBorderStyle}" Padding="0" ClipToBounds="True">
                                <DataGrid x:Name="CartGrid" ItemsSource="{Binding Cart}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource ThemeBorder}" BorderThickness="0" Background="Transparent" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" RowHeight="48" SelectionUnit="FullRow" SelectionMode="Single" EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForeground}" />
                                            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Padding" Value="12,10" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="12,4" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding ProductoId}" Width="0.55*" />
                                        <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="2.2*" />
                                        <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Cantidad, StringFormat={}{0:0.###}}" Width="0.85*" />
                                        <DataGridTextColumn Header="PRECIO UNIT." Binding="{Binding Precio, StringFormat={}{0:C2}}" Width="1.1*" />
                                        <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, StringFormat={}{0:C2}}" Width="1.1*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Border x:Name="EmptyCartPanel" Background="Transparent" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="64" Height="64" CornerRadius="4" Background="#108E8E93" BorderBrush="#208E8E93" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <TextBlock Text="🛒" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" />
                                    </Border>
                                    <TextBlock Text="El carrito esta vacio" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="Resumen" FontFamily="Segoe UI Variable, Segoe UI" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Articulos registrados" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" Foreground="{DynamicResource ThemeMutedForeground}" />
                                    <TextBlock x:Name="ProductCountText" Grid.Column="1" Text="1" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                </Grid>

                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Promociones aplicadas" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" Foreground="{DynamicResource ThemeMutedForeground}" />
                                    <TextBlock x:Name="PromotionsCountText" Grid.Column="1" Text="0" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Numero de venta" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" Foreground="{DynamicResource ThemeMutedForeground}" />
                                    <TextBlock x:Name="SaleNumberText" Grid.Column="1" Text="#0" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="20">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOTAL A COBRAR" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" />
                                <TextBlock x:Name="TotalText" Text="$0.00" FontFamily="Segoe UI Variable, Segoe UI" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,4,0,0" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform x:Name="TotalScaleTransform" ScaleX="1" ScaleY="1" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button x:Name="ChargeButton" Grid.Row="4" Height="52" Content="COBRAR  (Shift+Enter)" Style="{StaticResource ActionButtonStyle}" Click="StartPayment_Click" />

                        <TextBlock Grid.Row="5" Text="Pulsa Enter para añadir productos, o presiona F8 sobre un articulo para pesar en bascula." FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="4,12,4,0" />
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,14,0,0" Effect="{StaticResource FluentShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ShortcutTextStyle}"><Run Text="Enter" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" /><Run Text="  Añadir" /></TextBlock>
                            <TextBlock Style="{StaticResource ShortcutTextStyle}"><Run Text="Ctrl←/Tab" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" /><Run Text="  Buscar" /></TextBlock>
                            <TextBlock Style="{StaticResource ShortcutTextStyle}"><Run Text="F8" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" /><Run Text="  Pesar Bascula" /></TextBlock>
                            <TextBlock Style="{StaticResource ShortcutTextStyle}"><Run Text="Shift+Enter" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" /><Run Text="  Cobrar" /></TextBlock>
                            <TextBlock Style="{StaticResource ShortcutTextStyle}"><Run Text="Supr" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" /><Run Text="  Quitar" /></TextBlock>
                            <TextBlock Style="{StaticResource ShortcutTextStyle}"><Run Text="F10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" /><Run Text="  Stock Rapido" /></TextBlock>
                            <TextBlock Style="{StaticResource ShortcutTextStyle}" Margin="0"><Run Text="Esc" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" /><Run Text="  Volver" /></TextBlock>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnPausarVenta" Content="Pausar / Espera (F2)" Height="32" Padding="12,0" Margin="0,0,8,0" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Cursor="Hand" Click="BtnVentasEnEspera_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="Caja / Gasto (F4)" Height="32" Padding="12,0" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Cursor="Hand" Click="CashMovementButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="PaymentOverlay" Panel.ZIndex="10" Background="#66000000" Visibility="Collapsed" MouseDown="PaymentOverlay_MouseDown">
                <Border Width="560" Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="32,26" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource FluentModalShadow}">
                    <StackPanel>
                        <TextBlock Text="METODO DE PAGO" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,8" />

                        <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="4" Padding="2" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
