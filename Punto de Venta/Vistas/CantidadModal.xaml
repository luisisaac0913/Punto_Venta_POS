<Window x:Class="Punto_de_Venta.CantidadModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Imagenes/CHC_icono.ico"
        ShowInTaskbar="False"
        Title="Cantidad"
        Width="340" Height="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <DropShadowEffect x:Key="FluentModalShadow" BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.25" />
    </Window.Resources>

    <Border x:Name="ModalRootBorder"
            Background="{DynamicResource ThemeSurfaceBackground}" 
            CornerRadius="8" 
            BorderBrush="{DynamicResource ThemeBorder}" 
            BorderThickness="1" 
            Margin="10"
            Opacity="0"
            Effect="{StaticResource FluentModalShadow}"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ModalScaleTransform" ScaleX="1.0" ScaleY="1.0" />
        </Border.RenderTransform>

        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ModalRootBorder"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.0" To="1.0"
                                         Duration="0:0:0.12" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock x:Name="ProductTitleText" 
                           Text="Producto" 
                           FontFamily="Segoe UI Variable, Segoe UI" 
                           FontSize="17" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ThemeTextForeground}" 
                           TextAlignment="Center" 
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{DynamicResource QtyModalSubtitle}" 
                           FontSize="12" 
                           Foreground="{DynamicResource ThemeMutedForeground}" 
                           TextAlignment="Center" 
                           Margin="0,2,0,0" />
            </StackPanel>
            <Border Grid.Row="1" 
                    Style="{StaticResource FluentInputContainerStyle}" 
                    Height="42">
                <TextBox x:Name="QuantityBox"
                         Style="{StaticResource EmbeddedTextBoxStyle}"
                         FontSize="20"
                         FontWeight="Bold"
                         Foreground="{DynamicResource ThemeTextForeground}"
                         CaretBrush="{DynamicResource ThemeAccent}"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"
                         KeyDown="QuantityBox_KeyDown" />
            </Border>
            <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Content="{DynamicResource QtyModalCancel}" 
                        Height="36" 
                        Background="{DynamicResource ThemeInputBackground}" 
                        Foreground="{DynamicResource ThemeTextForeground}" 
                        FontFamily="Segoe UI Variable, Segoe UI" 
                        FontWeight="SemiBold" 
                        Cursor="Hand" 
                        Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CancelBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{DynamicResource ThemeBorder}" 
                                    BorderThickness="1" 
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CancelBorder" Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CancelBorder" Property="Opacity" Value="0.8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" 
                        Content="{DynamicResource QtyModalAccept}" 
                        Height="36" 
                        Background="{DynamicResource ThemeAccent}" 
                        Foreground="White" 
                        FontFamily="Segoe UI Variable, Segoe UI" 
                        FontWeight="SemiBold" 
                        Cursor="Hand" 
                        Click="Accept_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="AcceptBorder" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="AcceptBorder" Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="AcceptBorder" Property="Opacity" Value="0.8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>