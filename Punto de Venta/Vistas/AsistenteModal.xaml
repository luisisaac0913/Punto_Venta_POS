<Window x:Class="Punto_de_Venta.Vistas.AsistenteModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Punto_de_Venta.Vistas"
        Title="Asistente IA (Gemini)"
        Width="680" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource ThemeSurfaceBackground}"
            BorderBrush="{DynamicResource ThemeBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="✨ Asistente IA (Gemini)" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" />
                    <TextBlock Text="Consulta o modifica inventario, ventas, prestamos y promociones." FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Content="✕" Width="32" Height="32" DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeMutedForeground}"
                        FontSize="15" FontWeight="Bold" Cursor="Hand" Click="BtnCerrar_Click" />
            </DockPanel>

            <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                <Button Content="📦 Stock bajo" Padding="10,5" Margin="0,0,8,4" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Cursor="Hand" Click="BtnSugerenciaStock_Click" />
                <Button Content="💰 Ventas de hoy" Padding="10,5" Margin="0,0,8,4" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Cursor="Hand" Click="BtnSugerenciaVentas_Click" />
                <Button Content="📒 Deudores" Padding="10,5" Margin="0,0,8,4" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Cursor="Hand" Click="BtnSugerenciaDeudores_Click" />
            </WrapPanel>

            <Border Grid.Row="2" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ChatList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="12,8" CornerRadius="8"
                                        Background="{Binding Fondo}"
                                        HorizontalAlignment="{Binding Alineacion}"
                                        MaxWidth="520">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Autor}" FontSize="11" FontWeight="Bold" Foreground="{Binding ColorAutor}" Margin="0,0,0,3" />
                                        <TextBlock local:TextoMarkdownHelper.Markdown="{Binding Texto}" TextWrapping="Wrap"
                                                   Foreground="{Binding ColorTexto}" FontSize="13" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Height="40" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6">
                    <TextBox x:Name="PromptBox" Background="Transparent" BorderThickness="0" Padding="10,0"
                             VerticalContentAlignment="Center" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}"
                             CaretBrush="{DynamicResource ThemeAccent}" KeyDown="PromptBox_KeyDown" />
                </Border>

                <Button x:Name="BtnEnviar" Grid.Column="2" Content="Enviar" Height="40" Padding="20,0"
                        Background="{DynamicResource ThemeAccent}" Foreground="White" FontWeight="Bold" FontSize="13"
                        BorderThickness="0" Cursor="Hand" Click="BtnEnviar_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>

