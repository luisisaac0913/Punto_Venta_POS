<Window x:Class="Punto_de_Venta.CorteCiegoModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Corte de Caja"
        Width="440" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <DropShadowEffect x:Key="FluentModalShadow" BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.25" />
    </Window.Resources>

    <Border x:Name="ModalRootBorder"
            Background="{DynamicResource ThemeSurfaceBackground}" 
            CornerRadius="8" 
            BorderBrush="{DynamicResource ThemeBorder}" 
            BorderThickness="1" 
            Margin="10"
            Opacity="0"
            Effect="{StaticResource FluentModalShadow}"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ModalScaleTransform" ScaleX="1.0" ScaleY="1.0" />
        </Border.RenderTransform>

        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ModalRootBorder"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.0" To="1.0"
                                         Duration="0:0:0.12" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Corte de Turno" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" TextAlignment="Center" />
                <TextBlock x:Name="SubtituloCorte" Text="Ingresa los billetes de distinto valor" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" TextAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Billetes de $500:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,4" />
                        <Border Style="{StaticResource FluentInputContainerStyle}" Height="36">
                            <TextBox x:Name="Box500" Style="{StaticResource EmbeddedTextBoxStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" CaretBrush="{DynamicResource ThemeAccent}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextChanged="Denomination_TextChanged" KeyDown="Denomination_KeyDown" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Billetes de $200:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,4" />
                        <Border Style="{StaticResource FluentInputContainerStyle}" Height="36">
                            <TextBox x:Name="Box200" Style="{StaticResource EmbeddedTextBoxStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" CaretBrush="{DynamicResource ThemeAccent}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextChanged="Denomination_TextChanged" KeyDown="Denomination_KeyDown" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Billetes de $100:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,4" />
                        <Border Style="{StaticResource FluentInputContainerStyle}" Height="36">
                            <TextBox x:Name="Box100" Style="{StaticResource EmbeddedTextBoxStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" CaretBrush="{DynamicResource ThemeAccent}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextChanged="Denomination_TextChanged" KeyDown="Denomination_KeyDown" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Billetes de $50:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,4" />
                        <Border Style="{StaticResource FluentInputContainerStyle}" Height="36">
                            <TextBox x:Name="Box50" Style="{StaticResource EmbeddedTextBoxStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" CaretBrush="{DynamicResource ThemeAccent}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextChanged="Denomination_TextChanged" KeyDown="Denomination_KeyDown" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Billetes de $20:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,4" />
                        <Border Style="{StaticResource FluentInputContainerStyle}" Height="36">
                            <TextBox x:Name="Box20" Style="{StaticResource EmbeddedTextBoxStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" CaretBrush="{DynamicResource ThemeAccent}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextChanged="Denomination_TextChanged" KeyDown="Denomination_KeyDown" />
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelBoxCoins" Grid.Column="2">
                        <TextBlock Text="Monedas / Suelto ($):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,4" />
                        <Border Style="{StaticResource FluentInputContainerStyle}" Height="36">
                            <TextBox x:Name="BoxCoins" Style="{StaticResource EmbeddedTextBoxStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" CaretBrush="{DynamicResource ThemeAccent}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextChanged="Denomination_TextChanged" KeyDown="Denomination_KeyDown" />
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelBox10" Grid.Column="2" Visibility="Collapsed">
                        <TextBlock Text="Monedas de $10:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,4" />
                        <Border Style="{StaticResource FluentInputContainerStyle}" Height="36">
                            <TextBox x:Name="Box10" Style="{StaticResource EmbeddedTextBoxStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" CaretBrush="{DynamicResource ThemeAccent}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextChanged="Denomination_TextChanged" KeyDown="Denomination_KeyDown" />
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="PanelMonedasIndividuales" Visibility="Collapsed">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Monedas de $5:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,4" />
                            <Border Style="{StaticResource FluentInputContainerStyle}" Height="36">
                                <TextBox x:Name="Box5" Style="{StaticResource EmbeddedTextBoxStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" CaretBrush="{DynamicResource ThemeAccent}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextChanged="Denomination_TextChanged" KeyDown="Denomination_KeyDown" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Monedas de $2:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,4" />
                            <Border Style="{StaticResource FluentInputContainerStyle}" Height="36">
                                <TextBox x:Name="Box2" Style="{StaticResource EmbeddedTextBoxStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" CaretBrush="{DynamicResource ThemeAccent}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextChanged="Denomination_TextChanged" KeyDown="Denomination_KeyDown" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Monedas de $1:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,4" />
                            <Border Style="{StaticResource FluentInputContainerStyle}" Height="36">
                                <TextBox x:Name="Box1" Style="{StaticResource EmbeddedTextBoxStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" CaretBrush="{DynamicResource ThemeAccent}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextChanged="Denomination_TextChanged" KeyDown="Denomination_KeyDown" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Centavos / Suelto ($):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,4" />
                            <Border Style="{StaticResource FluentInputContainerStyle}" Height="36">
                                <TextBox x:Name="BoxCentavos" Style="{StaticResource EmbeddedTextBoxStyle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" CaretBrush="{DynamicResource ThemeAccent}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextChanged="Denomination_TextChanged" KeyDown="Denomination_KeyDown" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <TextBlock Text="Total en caja:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,4" />
                <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="4" Height="42">
                    <TextBox x:Name="CountedAmountBox"
                             Style="{StaticResource EmbeddedTextBoxStyle}"
                             Text="$0.00"
                             IsReadOnly="True"
                             Focusable="False"
                             FontSize="18"
                             FontWeight="Bold"
                             Foreground="{DynamicResource ThemeAccent}"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center" />
                </Border>

                <Border x:Name="AuditPanel" Visibility="Collapsed" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="4" Margin="0,12,0,0" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <TextBlock Text="Efectivo en Sistema:" Foreground="{DynamicResource ThemeMutedForeground}" FontSize="12" />
                            <TextBlock x:Name="ExpectedText" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeTextForeground}" />
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Efectivo Fisico:" Foreground="{DynamicResource ThemeMutedForeground}" FontSize="12" />
                            <TextBlock x:Name="CountedText" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeTextForeground}" />
                        </Grid>
                        <Separator Margin="0,6" Background="{DynamicResource ThemeBorder}" />
                        <Grid Margin="0,2">
                            <TextBlock Text="Diferencia:" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" />
                            <TextBlock x:Name="DifferenceText" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Content="Cancelar (Esc)" Height="36" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CanBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CanBorder" Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CanBorder" Property="Opacity" Value="0.8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="ActionBtn" Grid.Column="2" Content="Revisar" Height="36" Background="{DynamicResource ThemeAccent}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="Action_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ActBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ActBorder" Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ActBorder" Property="Opacity" Value="0.8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>