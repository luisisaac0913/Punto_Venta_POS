<Window x:Class="Punto_de_Venta.Vistas.Bienvenida"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Imagenes/CHC_icono.ico"
        Title="{DynamicResource WelcomeWindowTitle}" Height="690" Width="860"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource ThemeTextForeground}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <DropShadowEffect x:Key="FluentModalShadow" BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.25" />

        <Style x:Key="StepButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="40" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="48">
        <Border Background="{DynamicResource ThemeSurfaceBackground}" 
                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" 
                CornerRadius="8" Effect="{StaticResource FluentModalShadow}"
                IsHitTestVisible="False" />
        <Border CornerRadius="8">
            <Grid Margin="32,24,32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,32,0" VerticalAlignment="Center">
                        <StackPanel x:Name="PanelPasosIndicador" Orientation="Horizontal" Margin="0,0,0,6" Visibility="Collapsed">
                            <Border x:Name="BadgePaso1" CornerRadius="10" Padding="8,2" BorderThickness="1.2" BorderBrush="{DynamicResource ThemeAccent}" Cursor="Hand" MouseLeftButtonUp="BadgePaso1_Click">
                                <TextBlock x:Name="TxtBadgePaso1" Text="1. Tienda" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" />
                            </Border>
                            <TextBlock Text="·" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeMutedForeground}" FontWeight="Bold" />
                            <Border x:Name="BadgePaso2" CornerRadius="10" Padding="8,2" BorderThickness="1.2" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonUp="BadgePaso2_Click">
                                <TextBlock x:Name="TxtBadgePaso2" Text="2. Hardware" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedForeground}" />
                            </Border>
                            <TextBlock Text="·" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeMutedForeground}" FontWeight="Bold" />
                            <Border x:Name="BadgePaso3" CornerRadius="10" Padding="8,2" BorderThickness="1.2" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonUp="BadgePaso3_Click">
                                <TextBlock x:Name="TxtBadgePaso3" Text="3. Caja" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedForeground}" />
                            </Border>
                        </StackPanel>
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource ThemeBorder}">
                            <ProgressBar x:Name="BarraProgreso" Minimum="0" Maximum="3" Value="1" Background="Transparent" Foreground="{DynamicResource ThemeAccent}" BorderThickness="0" Visibility="Collapsed" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ComboBox x:Name="CmbIdiomaHeader" Width="105" Height="28" FontSize="12" Margin="0,0,12,0" VerticalContentAlignment="Center" SelectionChanged="CmbIdiomaHeader_SelectionChanged">
                            <ComboBoxItem Content="Español" Tag="es" />
                            <ComboBoxItem Content="English" Tag="en" />
                        </ComboBox>
                        <Button x:Name="BtnThemeToggle" Content="🌙" FontSize="15" Width="34" Height="30" Padding="0" Style="{StaticResource FluentButtonSubtle}" Margin="0,0,6,0" Click="BtnThemeToggle_Click" ToolTip="{DynamicResource WelcomeThemeTooltip}" />
                        <Button x:Name="BtnCerrar" Content="✕" FontSize="14" Width="34" Height="30" Padding="0" Style="{StaticResource FluentButtonSubtle}" Click="BtnCerrar_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <StackPanel x:Name="PanelPaso0" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
                        <Image Source="pack://application:,,,/Imagenes/CHC_logo.png" Width="220" Height="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" Margin="0,0,0,20" />

                        <TextBlock Text="{DynamicResource WelcomeTitle}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="{DynamicResource WelcomeSubtitle}" FontSize="14" Foreground="{DynamicResource ThemeMutedForeground}" HorizontalAlignment="Center" Margin="0,0,0,22" />

                        <Button x:Name="BtnIniciarIntro" Content="{DynamicResource WelcomeStartBtn}" Width="180" Height="40" FontSize="14" Style="{StaticResource StepButtonStyle}" Click="BtnIniciarIntro_Click" />
                        <Button x:Name="BtnRestaurarRespaldo" Content="{DynamicResource WelcomeRestoreBtn}" Margin="0,10,0,0"
                                Style="{StaticResource FluentButtonSubtle}" Foreground="{DynamicResource ThemeAccent}"
                                FontSize="12" FontWeight="SemiBold" Height="30" Padding="12,0" Click="BtnRestaurarRespaldo_Click" />
                        <Button x:Name="BtnOmitirIntro" Content="{DynamicResource WelcomeSkipBtn}" Margin="0,4,0,0"
                                Style="{StaticResource FluentButtonSubtle}" Foreground="{DynamicResource ThemeMutedForeground}"
                                FontSize="11.5" Height="28" Padding="12,0" Click="BtnOmitirIntro_Click" />
                    </StackPanel>

                    <Grid x:Name="PanelPaso1" VerticalAlignment="Center" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource WelcomeStep1Title}" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource WelcomeStep1Progress}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,18" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="135" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource WelcomeStoreNameLabel}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBox x:Name="TxtNombreNegocio" Style="{StaticResource FormInputStyle}" TextChanged="TicketPreviewInputs_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource WelcomeTicketWidth}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="CmbAnchoTicket" Height="38" VerticalContentAlignment="Center" SelectedIndex="1" SelectionChanged="CmbAnchoTicket_SelectionChanged">
                                        <ComboBoxItem Content="58 mm (32 col)" Tag="32" />
                                        <ComboBoxItem Content="80 mm (42 col)" Tag="42" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="LblDireccion" Text="{DynamicResource WelcomeAddressLabel}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox x:Name="TxtDireccion" Style="{StaticResource FormInputStyle}" Margin="0,0,0,12" TextChanged="TicketPreviewInputs_Changed" />

                            <TextBlock x:Name="LblMensajeTicket" Text="{DynamicResource WelcomeTicketMsgLabel}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox x:Name="TxtMensajePie" Text="{DynamicResource WelcomeTicketMsgDefault}" Style="{StaticResource FormInputStyle}" TextChanged="TicketPreviewInputs_Changed" />
                        </StackPanel>

                        <Border Grid.Column="2" VerticalAlignment="Center" Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.14" Color="#000000" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource WelcomeTicketPreview}" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8" />
                                <TextBlock x:Name="TxtPreviewTicket" FontFamily="Consolas" FontSize="10.5" Foreground="#1F2937" HorizontalAlignment="Center" TextAlignment="Left" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="PanelPaso2" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="520">
                        <TextBlock Text="{DynamicResource WelcomeStep2Title}" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource WelcomeStep2Progress}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,18" />
                        <TextBlock Text="{DynamicResource WelcomePrinterLabel}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbImpresoras" Grid.Column="0" Height="36" VerticalContentAlignment="Center" />
                            <Button x:Name="BtnProbarImpresora" Grid.Column="2" Content="{DynamicResource WelcomeTestPrinter}" Height="36" Style="{StaticResource StepButtonStyle}" FontSize="12" Click="BtnProbarImpresora_Click" />
                        </Grid>

                        <CheckBox x:Name="ChkUsarBascula" Content="{DynamicResource WelcomeUseScaleCheck}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" Checked="ChkUsarBascula_Changed" Unchecked="ChkUsarBascula_Changed" />
                        <TextBlock Text="{DynamicResource WelcomeScalePortLabel}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbPuertosCOM" Grid.Column="0" Height="36" VerticalContentAlignment="Center" IsEnabled="False" />
                            <Button x:Name="BtnProbarBascula" Grid.Column="2" Content="{DynamicResource WelcomeTestScale}" Height="36" Style="{StaticResource StepButtonStyle}" FontSize="12" IsEnabled="False" Click="BtnProbarBascula_Click" />
                        </Grid>
                        <TextBlock x:Name="TxtPruebaHardware" Text="" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" TextWrapping="Wrap" MinHeight="18" />
                    </StackPanel>

                    <StackPanel x:Name="PanelPaso3" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="500">
                        <TextBlock Text="{DynamicResource WelcomeStep3Title}" FontSize="22" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="{DynamicResource WelcomeStep3Progress}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,24" />

                        <TextBlock Text="{DynamicResource WelcomeCashFundLabel}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox x:Name="TxtFondoCaja" Text="500.00" Style="{StaticResource FormInputStyle}" Margin="0,0,0,24" />

                        <TextBlock x:Name="LblPinAdminTitulo" Text="{DynamicResource WelcomePinTitle}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <PasswordBox x:Name="TxtPinAdmin" MaxLength="4" Style="{StaticResource FormPasswordStyle}" Margin="0,0,0,8" />
                        <TextBlock x:Name="LblPinAdminDesc" Text="{DynamicResource WelcomePinDesc}" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" TextWrapping="Wrap" />

                        <Border x:Name="BannerPromoGratis" Visibility="Collapsed" Margin="0,18,0,0" Padding="12,10" CornerRadius="6"
                                Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtPromoGratisTitulo" Text="{DynamicResource WelcomeFreeReady}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtPromoGratisDesc"
                                           Text="{DynamicResource WelcomeFreeDesc}"
                                           FontSize="11.5" Foreground="{DynamicResource ThemeMutedForeground}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="GridNavegacion" Grid.Row="2" Margin="0,20,0,0" Visibility="Collapsed" MaxWidth="500">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnAnterior" Grid.Column="0" HorizontalAlignment="Left" Content="{DynamicResource WelcomeBackBtn}" Width="96" Height="38" Style="{StaticResource FluentButtonSubtle}" Visibility="Hidden" Click="BtnAnterior_Click" />
                    <Button x:Name="BtnSiguiente" Grid.Column="1" Content="{DynamicResource WelcomeNextBtn}" Width="130" Style="{StaticResource StepButtonStyle}" Click="BtnSiguiente_Click" />
                    <Button x:Name="BtnFinalizar" Grid.Column="1" Content="{DynamicResource WelcomeFinishBtn}" Width="170" Style="{StaticResource StepButtonStyle}" Background="#34C759" Visibility="Hidden" Click="BtnFinalizar_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>